{
  "version": 2,
  "installCommand": "rm -rf node_modules package-lock.json && npm install --no-optional",
  "buildCommand": "npm run build || (npm install --include=optional && npm run build)",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
